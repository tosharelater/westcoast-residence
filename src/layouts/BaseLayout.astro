---
import '../styles/global.css';
import '../styles/theme.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { withBase } from '../utils/paths';

interface Props {
  title: string;
  description: string;
  whatsappMessage?: string;
  ogImage?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  solidNav?: boolean;
  preloadImage?: string;
}

const {
  title,
  description,
  whatsappMessage,
  ogImage = '/images/hero-facade.webp',
  schema,
  solidNav = false,
  preloadImage,
} = Astro.props;

const fullTitle = title.includes('West Coast')
  ? title
  : `${title} | West Coast Residence`;

const resolvedOg = withBase(ogImage);
const favicon = withBase('/logos/westcoast-logo.webp');
const fontsHref =
  'https://fonts.googleapis.com/css2?family=Crimson+Pro:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@400;500;600;700&display=swap';
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#221c13" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
    <link rel="icon" type="image/webp" href={favicon} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(resolvedOg, Astro.site).href} />
    <meta property="og:locale" content="fr_MA" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {
      preloadImage && (
        <link
          rel="preload"
          as="image"
          href={withBase(preloadImage)}
          fetchpriority="high"
        />
      )
    }
    <link
      rel="preload"
      href={fontsHref}
      as="style"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link href={fontsHref} rel="stylesheet" />
    </noscript>
    <title>{fullTitle}</title>
    {
      schema && (
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
      )
    }
  </head>
  <body class:list={[{ 'solid-nav': solidNav }]}>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <WhatsAppFloat message={whatsappMessage} />
    <CookieBanner />
    <script>
      const reveal = () => {
        const els = document.querySelectorAll(
          '.reveal, .reveal-left, [data-reveal]'
        );
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -6% 0px' }
        );
        els.forEach((el) => io.observe(el));
      };
      reveal();

      const header = document.querySelector('[data-header]');
      let stickyQueued = false;
      const onScroll = () => {
        if (!header || stickyQueued) return;
        stickyQueued = true;
        requestAnimationFrame(() => {
          header.classList.toggle('is-sticky', window.scrollY > 120);
          stickyQueued = false;
        });
      };
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });

      const openBtn = document.querySelector('[data-nav-open]');
      const closeBtn = document.querySelector('[data-nav-close]');
      const panel = document.querySelector('[data-nav-panel]');
      const setOpen = (open: boolean) => {
        panel?.classList.toggle('is-open', open);
        document.body.classList.toggle('nav-open', open);
      };
      openBtn?.addEventListener('click', () => setOpen(true));
      closeBtn?.addEventListener('click', () => setOpen(false));
      panel?.querySelectorAll('a').forEach((a) =>
        a.addEventListener('click', () => setOpen(false))
      );

      // Counters
      const counters = document.querySelectorAll('[data-count]');
      const countIo = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            const el = entry.target as HTMLElement;
            const target = Number(el.dataset.count || 0);
            const suffix = el.dataset.suffix || '';
            const prefix = el.dataset.prefix || '';
            const duration = 1600;
            const start = performance.now();
            const tick = (now: number) => {
              const p = Math.min(1, (now - start) / duration);
              const eased = 1 - Math.pow(1 - p, 3);
              const value = Math.round(target * eased);
              el.textContent = `${prefix}${value.toLocaleString('fr-FR')}${suffix}`;
              if (p < 1) requestAnimationFrame(tick);
            };
            requestAnimationFrame(tick);
            countIo.unobserve(el);
          });
        },
        { threshold: 0.4 }
      );
      counters.forEach((c) => countIo.observe(c));

      // Light parallax (rAF-throttled) on why section
      const whyBg = document.querySelector(
        '[data-parallax]'
      ) as HTMLElement | null;
      if (whyBg) {
        let parallaxQueued = false;
        window.addEventListener(
          'scroll',
          () => {
            if (parallaxQueued) return;
            parallaxQueued = true;
            requestAnimationFrame(() => {
              const rect = whyBg.parentElement?.getBoundingClientRect();
              if (rect) {
                whyBg.style.transform = `translateY(${rect.top * -0.12}px) scale(1.06)`;
              }
              parallaxQueued = false;
            });
          },
          { passive: true }
        );
      }
    </script>
  </body>
</html>
