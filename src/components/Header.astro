---
import { nav, site, whatsappUrl } from '../data/site';
import { withBase } from '../utils/paths';

const base = import.meta.env.BASE_URL.replace(/\/$/, '') || '';
const rawPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const pathname =
  base && rawPath.startsWith(base)
    ? rawPath.slice(base.length) || '/'
    : rawPath || '/';
---

<header class="site-header" data-header>
  <div class="header-top">
    <div class="header-top__inner">
      <div class="header-top__left">
        <p>{site.hours}</p>
      </div>
      <div class="header-top__right">
        <span>{site.address}</span>
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </div>
    </div>
  </div>

  <div class="header-bar">
    <a class="header-brand" href={withBase('/')} aria-label={site.name}>
      <img
        src={withBase('/logos/westcoast-logo.png')}
        alt="West Coast Residence"
        width="180"
        height="56"
      />
    </a>

    <nav class="header-nav" aria-label="Navigation principale">
      <ul>
        {
          nav.map((item) => {
            const itemPath = item.href
              .replace(base, '')
              .replace(/\/$/, '')
              .split('#')[0] || '/';
            const active =
              itemPath === '/'
                ? pathname === '/'
                : pathname === itemPath || pathname.startsWith(`${itemPath}/`);
            return (
              <li>
                <a href={item.href} class:list={[{ 'is-active': active }]}>
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="header-actions">
      <a
        class="thm-btn thm-btn--base"
        href={whatsappUrl()}
        target="_blank"
        rel="noopener noreferrer"
      >
        Visite
      </a>
      <button class="nav-burger" type="button" aria-label="Menu" data-nav-open>
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</header>

<div class="mobile-nav" data-nav-panel>
  <button
    class="mobile-nav__close"
    type="button"
    aria-label="Fermer"
    data-nav-close
  >
    ×
  </button>
  <ul>
    {
      nav.map((item) => (
        <li>
          <a href={item.href}>{item.label}</a>
        </li>
      ))
    }
  </ul>
  <a
    class="thm-btn thm-btn--base"
    href={whatsappUrl()}
    target="_blank"
    rel="noopener noreferrer"
  >
    Écrire sur WhatsApp
  </a>
</div>
