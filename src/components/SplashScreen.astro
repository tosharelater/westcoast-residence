---
import { withBase } from '../utils/paths';
---

<div class="splash" data-splash aria-hidden="true">
  <span class="splash__sweep" aria-hidden="true"></span>
  <img
    class="splash__logo"
    src={withBase('/logos/westcoast-logo.png')}
    alt="West Coast Residence"
    width="220"
    height="70"
  />
</div>

<script>
  const splash = document.querySelector('[data-splash]');
  const minMs = 1200;
  const start = performance.now();

  const hide = () => {
    if (!splash) return;
    splash.classList.add('is-done');
    document.body.classList.remove('splash-lock');
    window.setTimeout(() => splash.remove(), 600);
  };

  document.body.classList.add('splash-lock');

  const finish = () => {
    const wait = Math.max(0, minMs - (performance.now() - start));
    window.setTimeout(hide, wait);
  };

  if (document.readyState === 'complete') finish();
  else window.addEventListener('load', finish, { once: true });
  window.setTimeout(hide, 2800);
</script>

<style>
  .splash {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: grid;
    place-items: center;
    background: #14110e;
    overflow: hidden;
    transition:
      opacity 0.55s ease,
      visibility 0.55s;
  }

  .splash.is-done {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  :global(body.splash-lock) {
    overflow: hidden;
  }

  .splash__logo {
    position: relative;
    z-index: 2;
    width: clamp(150px, 38vw, 200px);
    height: auto;
    filter: brightness(0) invert(1);
    opacity: 0.95;
  }

  /* Very faded line sweeping right → left under the logo */
  .splash__sweep {
    position: absolute;
    top: 54%;
    left: -20%;
    width: 55%;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(255, 255, 255, 0.08) 35%,
      rgba(176, 125, 71, 0.22) 50%,
      rgba(255, 255, 255, 0.08) 65%,
      transparent 100%
    );
    transform: translateX(140%);
    animation: sweepLeft 1.8s ease-in-out infinite;
    pointer-events: none;
  }

  @keyframes sweepLeft {
    from {
      transform: translateX(140%);
    }
    to {
      transform: translateX(-160%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .splash__sweep {
      animation: none;
      opacity: 0.2;
      transform: none;
      left: 22.5%;
    }
  }
</style>
