---
---

<div class="splash" data-splash aria-hidden="true">
  <div class="splash__inner">
    <img
      class="splash__logo"
      src={`${import.meta.env.BASE_URL}logos/westcoast-logo.png`}
      alt="West Coast Residence"
      width="220"
      height="70"
    />
    <div class="splash__line" aria-hidden="true"></div>
    <p class="splash__tag">Mohammedia</p>
    <div class="splash__bar" aria-hidden="true">
      <span></span>
    </div>
  </div>
</div>

<script>
  const splash = document.querySelector('[data-splash]');
  const KEY = 'wc_splash_seen';
  const minMs = 1400;
  const start = performance.now();

  const hide = () => {
    if (!splash) return;
    splash.classList.add('is-done');
    document.body.classList.remove('splash-lock');
    window.setTimeout(() => splash.remove(), 700);
    try {
      sessionStorage.setItem(KEY, '1');
    } catch (_) {
      /* ignore */
    }
  };

  // Show once per tab session for a cleaner revisit
  let skip = false;
  try {
    skip = sessionStorage.getItem(KEY) === '1';
  } catch (_) {
    skip = false;
  }

  if (skip) {
    splash?.remove();
  } else {
    document.body.classList.add('splash-lock');
    const finish = () => {
      const wait = Math.max(0, minMs - (performance.now() - start));
      window.setTimeout(hide, wait);
    };
    if (document.readyState === 'complete') finish();
    else window.addEventListener('load', finish, { once: true });
    // Safety fallback
    window.setTimeout(hide, 3200);
  }
</script>

<style>
  .splash {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: grid;
    place-items: center;
    background: #14110e;
    transition:
      opacity 0.65s cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0.65s;
  }

  .splash.is-done {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  :global(body.splash-lock) {
    overflow: hidden;
  }

  .splash__inner {
    text-align: center;
    padding: 2rem;
    animation: splashIn 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .splash__logo {
    width: clamp(160px, 42vw, 220px);
    height: auto;
    margin: 0 auto 1.25rem;
    filter: brightness(0) invert(1);
    opacity: 0.95;
  }

  .splash__line {
    width: 48px;
    height: 1px;
    background: #b07d47;
    margin: 0 auto 0.85rem;
    transform-origin: center;
    animation: lineGrow 0.8s 0.25s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .splash__tag {
    margin: 0 0 1.75rem;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
  }

  .splash__bar {
    width: 120px;
    height: 2px;
    margin: 0 auto;
    background: rgba(255, 255, 255, 0.12);
    overflow: hidden;
  }

  .splash__bar span {
    display: block;
    height: 100%;
    width: 40%;
    background: #b07d47;
    animation: barSlide 1.1s ease-in-out infinite;
  }

  @keyframes splashIn {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes lineGrow {
    from {
      transform: scaleX(0);
      opacity: 0;
    }
    to {
      transform: scaleX(1);
      opacity: 1;
    }
  }

  @keyframes barSlide {
    0% {
      transform: translateX(-120%);
    }
    100% {
      transform: translateX(320%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .splash__inner,
    .splash__line,
    .splash__bar span {
      animation: none;
    }
  }
</style>
