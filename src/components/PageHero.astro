---
import { withBase } from '../utils/paths';

interface Props {
  title: string;
  subtitle?: string;
  image: string;
  alt: string;
  compact?: boolean;
}

const { title, subtitle, image, alt } = Astro.props;
---

<section class="page-hero">
  <div class="page-hero__media" aria-hidden="true">
    <img
      src={image}
      alt={alt}
      width="1600"
      height="1067"
      decoding="async"
      fetchpriority="high"
    />
  </div>
  <div class="page-hero__shade"></div>
  <div class="page-hero__content">
    <h1>{title}</h1>
    {subtitle && <p class="page-hero__sub">{subtitle}</p>}
    <slot />
  </div>
</section>
