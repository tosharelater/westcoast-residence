---
import { site } from '../data/site';

interface Props {
  overlap?: boolean;
  colored?: boolean;
}

const { overlap = false, colored = false } = Astro.props;
---

<section
  class:list={[
    'google-map',
    { 'google-map--overlap': overlap, 'google-map--colored': colored },
  ]}
>
  <iframe
    class="google-map__one"
    title="Carte West Coast Residence Mohammedia"
    src={site.mapsEmbed}
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
    allowfullscreen
  />
</section>
