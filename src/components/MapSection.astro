---
import { site } from '../data/site';

interface Props {
  overlap?: boolean;
}

const { overlap = false } = Astro.props;
---

<section class:list={['google-map', { 'google-map--overlap': overlap }]}>
  <iframe
    class="google-map__one"
    title="Carte West Coast Residence Mohammedia"
    src={site.mapsEmbed}
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
    allowfullscreen
  />
</section>

<style>
  .google-map {
    position: relative;
    display: block;
    background-color: var(--wc-primary);
  }

  /* Homepage: slide up under the dark contact form box (Alipes-style) */
  .google-map--overlap {
    margin-top: -230px;
  }

  @media (max-width: 991px) {
    .google-map--overlap {
      margin-top: 0;
    }
  }

  .google-map__one {
    display: block;
    border: none;
    height: 475px;
    width: 100%;
    mix-blend-mode: luminosity;
  }
</style>
