---
import { site, whatsappUrl } from '../data/site';
import { withBase } from '../utils/paths';

interface Props {
  title?: string;
  text?: string;
  showTypology?: boolean;
  showActivity?: boolean;
  showSurface?: boolean;
  pageSource?: string;
  compact?: boolean;
  overlap?: boolean;
  whatsappLabel?: string;
}

const {
  title = 'Une question ? Une visite à organiser ?',
  text = 'Laissez vos coordonnées, on vous recontacte rapidement. Ou écrivez-nous directement sur WhatsApp.',
  showTypology = true,
  showActivity = false,
  showSurface = false,
  pageSource = 'accueil',
  compact = false,
  overlap = false,
  whatsappLabel = 'Écrire sur WhatsApp',
} = Astro.props;

const formBg = withBase('/theme/contact-form-bg-img-1.webp');

const phoneIcon =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8.1 10a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.9.5 2.9.7a2 2 0 0 1 1.6 1.9z"/></svg>';
const mailIcon =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>';
const pinIcon =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg>';
const clockIcon =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>';
---

<section
  class:list={[
    'section',
    'contact-one',
    { 'contact-one--compact': compact, 'contact-one--overlap': overlap },
  ]}
>
  <div class="container contact-one__grid">
    <div class="contact-one__left reveal">
      <div class="section-title">
        <span class="section-title__tagline">Contact</span>
        <h2 class="section-title__title">{title}</h2>
      </div>
      <p>{text}</p>
      <div class="cta-row">
        <a
          class="thm-btn thm-btn--whatsapp"
          href={whatsappUrl()}
          target="_blank"
          rel="noopener noreferrer"
        >
          {whatsappLabel}
        </a>
      </div>
      <ul class="contact-one__points">
        <li>
          <span class="icon" set:html={phoneIcon} />
          <div class="content">
            <p>Une question ?</p>
            <h4><a href={`tel:${site.phone}`}>{site.phoneDisplay}</a></h4>
          </div>
        </li>
        <li>
          <span class="icon" set:html={mailIcon} />
          <div class="content">
            <p>Écrivez-nous</p>
            <h4><a href={`mailto:${site.email}`}>{site.email}</a></h4>
          </div>
        </li>
        <li>
          <span class="icon" set:html={pinIcon} />
          <div class="content">
            <p>Localisation</p>
            <h4>
              <a href={site.mapsLink} target="_blank" rel="noopener noreferrer"
                >{site.address}</a
              >
            </h4>
          </div>
        </li>
        <li>
          <span class="icon" set:html={clockIcon} />
          <div class="content">
            <p>Horaires</p>
            <h4>{site.hours}</h4>
          </div>
        </li>
      </ul>
    </div>

    <div class="contact-one__right reveal">
      <div class="contact-one__form-box">
        <div
          class="contact-form-bg"
          style={`background-image:url('${formBg}')`}
        ></div>
        <div class="section-title">
          <span class="section-title__tagline">Contact</span>
          <h2 class="section-title__title">Écrivez-nous</h2>
        </div>

        <form class="form" data-contact-form novalidate>
          <div class="form-fields">
            <input type="hidden" name="page" value={pageSource} />
            <input type="hidden" name="utm_source" data-utm="utm_source" />
            <input type="hidden" name="utm_medium" data-utm="utm_medium" />
            <input
              type="hidden"
              name="utm_campaign"
              data-utm="utm_campaign"
            />

            <div class="contact-one__input-box">
              <label class="sr-only" for={`name-${pageSource}`}>Nom</label>
              <input
                id={`name-${pageSource}`}
                name="name"
                type="text"
                placeholder="Votre nom"
                required
                autocomplete="name"
              />
            </div>
            <div class="contact-one__input-box">
              <label class="sr-only" for={`phone-${pageSource}`}>Téléphone</label>
              <input
                id={`phone-${pageSource}`}
                name="phone"
                type="tel"
                placeholder="Téléphone"
                required
                autocomplete="tel"
                inputmode="tel"
              />
            </div>
            <div class="contact-one__input-box">
              <label class="sr-only" for={`email-${pageSource}`}>Email</label>
              <input
                id={`email-${pageSource}`}
                name="email"
                type="email"
                placeholder="Email"
                autocomplete="email"
              />
            </div>

            {
              showTypology && (
                <div class="contact-one__input-box">
                  <label class="sr-only" for={`interest-${pageSource}`}>
                    Ce qui vous intéresse
                  </label>
                  <select id={`interest-${pageSource}`} name="interest">
                    <option value="">Ce qui vous intéresse</option>
                    <option>Studio</option>
                    <option>Appartement</option>
                    <option>Commerce</option>
                    <option>Bureau</option>
                  </select>
                </div>
              )
            }

            {
              showActivity && (
                <div class="contact-one__input-box">
                  <label class="sr-only" for={`activity-${pageSource}`}>
                    Activité
                  </label>
                  <input
                    id={`activity-${pageSource}`}
                    name="activity"
                    type="text"
                    placeholder="Votre activité"
                  />
                </div>
              )
            }

            {
              showSurface && (
                <div class="contact-one__input-box">
                  <label class="sr-only" for={`surface-${pageSource}`}>
                    Surface recherchée
                  </label>
                  <input
                    id={`surface-${pageSource}`}
                    name="surface"
                    type="text"
                    placeholder="Surface recherchée (ex. 80 m²)"
                  />
                </div>
              )
            }

            {
              !compact && (
                <div class="contact-one__input-box text-message-box">
                  <label class="sr-only" for={`message-${pageSource}`}>
                    Message (optionnel)
                  </label>
                  <textarea
                    id={`message-${pageSource}`}
                    name="message"
                    rows="4"
                    placeholder="Écrivez votre message"
                  />
                </div>
              )
            }

            <p class="form-note">
              Vos informations sont utilisées uniquement pour vous recontacter au
              sujet de West Coast Residence.
            </p>
            <button class="thm-btn contact-one__btn" type="submit">
              Envoyer un message
            </button>
          </div>

          <div class="form-success" role="status">
            <strong>Merci, nous vous recontactons rapidement.</strong>
            <p style="margin:0.75rem 0 1rem">
              Vous pouvez aussi nous écrire sur WhatsApp.
            </p>
            <a
              class="thm-btn thm-btn--whatsapp"
              href={whatsappUrl()}
              target="_blank"
              rel="noopener noreferrer"
            >
              Ouvrir WhatsApp
            </a>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-one--compact {
    padding: 70px 0;
  }

  /* Homepage: the full-width map below slides under the dark form box */
  .contact-one--overlap {
    position: relative;
    z-index: 2;
    pointer-events: none;
  }

  .contact-one--overlap :global(.contact-one__right) {
    pointer-events: auto;
  }

  .contact-one--overlap :global(.contact-one__left) {
    pointer-events: none;
  }

  .contact-one--overlap :global(.contact-one__left > *) {
    pointer-events: auto;
  }

  .contact-one .section-title {
    margin-bottom: 36px;
  }

  .contact-one .cta-row {
    margin-top: 22px;
  }
</style>

<script>
  document.querySelectorAll('[data-contact-form]').forEach((form) => {
    const params = new URLSearchParams(window.location.search);
    form.querySelectorAll('[data-utm]').forEach((input) => {
      const key = input.getAttribute('data-utm');
      if (key && input instanceof HTMLInputElement) {
        input.value = params.get(key) || '';
      }
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!(form instanceof HTMLFormElement)) return;
      if (!form.reportValidity()) return;
      const data = Object.fromEntries(new FormData(form).entries());
      console.info('[West Coast lead]', data);
      form.classList.add('is-success');
    });
  });
</script>
