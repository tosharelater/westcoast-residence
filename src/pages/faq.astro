---
import { withBase } from '../utils/paths';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { faqItems, whatsappUrl } from '../data/site';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.flatMap((group) =>
    group.items.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.a,
      },
    }))
  ),
};
---

<BaseLayout
  title="Questions Fréquentes, Achat Immobilier Mohammedia"
  description="Vos questions sur West Coast Residence à Mohammedia : chantier livré, financement, Daam Sakane, étapes d'achat, visites. Réponses claires."
  schema={schema}
>
  <PageHero
    title="Vos questions, nos réponses"
    subtitle="Tout ce qu'on nous demande le plus souvent, avant de se décider."
    image={withBase("/images/interior-27.webp")}
    alt="West Coast Residence FAQ"
    compact
  />

  <section class="section">
    <div class="container faq">
      {
        faqItems.map((group) => (
          <div class="faq__group reveal">
            <h2>{group.category}</h2>
            <div class="faq__list">
              {group.items.map((item) => (
                <details>
                  <summary>{item.q}</summary>
                  <p>{item.a}</p>
                </details>
              ))}
            </div>
          </div>
        ))
      }

      <div class="faq__cta reveal">
        <h2>Une autre question ?</h2>
        <p>Écrivez-nous, on vous répond rapidement.</p>
        <a class="thm-btn thm-btn--whatsapp" href={whatsappUrl()} target="_blank" rel="noopener noreferrer">
          WhatsApp
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .faq {
    max-width: 820px;
  }

  .faq__group + .faq__group {
    margin-top: 2.75rem;
  }

  .faq__group h2 {
    margin-bottom: 1rem;
  }

  details {
    border-top: 1px solid var(--line);
    padding: 1rem 0;
  }

  details:last-child {
    border-bottom: 1px solid var(--line);
  }

  summary {
    cursor: pointer;
    font-weight: 500;
    color: var(--ink);
    list-style: none;
    padding-right: 1.5rem;
    position: relative;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    content: '+';
    position: absolute;
    right: 0;
    top: 0;
    color: var(--bronze);
    font-size: 1.2rem;
  }

  details[open] summary::after {
    content: '–';
  }

  details p {
    margin: 0.85rem 0 0.25rem;
  }

  .faq__cta {
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }
</style>
