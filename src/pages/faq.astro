---
import { withBase } from '../utils/paths';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { faqItems } from '../data/site';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.flatMap((group) =>
    group.items.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.a,
      },
    }))
  ),
};
---

<BaseLayout
  title="Questions Fréquentes, Achat Immobilier Mohammedia"
  description="Vos questions sur West Coast Residence à Mohammedia : chantier livré, financement, Daam Sakane, étapes d'achat, visites. Réponses claires."
  schema={schema}
>
  <PageHero
    title="Foire aux questions"
    subtitle="Quatre thèmes, les réponses claires dont vous avez besoin avant de vous décider. Une autre question ? Écrivez-nous."
    image={withBase("/images/interior-27.webp")}
    alt="West Coast Residence FAQ"
    compact
  />

  <section class="section">
    <div class="container faq">
      {
        faqItems.map((group, gi) => (
          <div class="faq__group reveal">
            <h2>
              <span class="faq__group-num">{String(gi + 1).padStart(2, '0')}</span>
              <span>{group.category}</span>
            </h2>
            <div class="faq__list">
              {group.items.map((item) => (
                <details>
                  <summary>
                    <span class="faq__q">{item.q}</span>
                    <span class="faq__toggle" aria-hidden="true"></span>
                  </summary>
                  <p>{item.a}</p>
                </details>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="faq-cta">
    <div class="container faq-cta__inner reveal">
      <span class="section-title__tagline">Avant de vous décider</span>
      <h2 class="section-title__title">Une autre question ?</h2>
      <p>Écrivez-nous, on vous répond rapidement — souvent dans l'heure.</p>
      <div class="cta-row">
        <a class="thm-btn thm-btn--base" href={withBase('/contact')}>
          Nous contacter
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .faq {
    max-width: 840px;
  }

  .faq__intro {
    margin-bottom: 3rem;
  }

  .faq__intro p {
    margin: 14px 0 0;
    color: var(--wc-gray);
    font-size: 16px;
    line-height: 1.65;
    max-width: 44ch;
  }

  .faq__group + .faq__group {
    margin-top: 3.5rem;
  }

  .faq__group:first-child {
    margin-top: 0;
  }

  .faq__group h2 {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin: 0 0 1.1rem;
    font-family: var(--wc-font-display);
    font-size: clamp(1.6rem, 2.6vw, 2rem);
    font-weight: 500;
    line-height: 1.2;
    color: var(--wc-black);
  }

  .faq__group-num {
    font-family: var(--wc-font);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--wc-base);
  }

  .faq__list {
    border-top: 1px solid rgba(var(--wc-black-rgb), 0.12);
  }

  details {
    border-bottom: 1px solid rgba(var(--wc-black-rgb), 0.12);
    interpolate-size: allow-keywords;
  }

  details::details-content {
    block-size: 0;
    overflow: clip;
    content-visibility: auto;
    transition:
      block-size 0.55s var(--wc-ease),
      content-visibility 0.55s allow-discrete;
  }

  details[open]::details-content {
    block-size: auto;
    content-visibility: visible;
  }

  summary {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    cursor: pointer;
    padding: 22px 4px 22px 0;
    font-family: var(--wc-font-display);
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    font-weight: 500;
    line-height: 1.4;
    color: var(--wc-black);
    list-style: none;
    transition: color 0.35s ease;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover {
    color: var(--wc-base);
  }

  details[open] summary {
    color: var(--wc-base);
  }

  .faq__toggle {
    position: relative;
    flex: 0 0 auto;
    width: 30px;
    height: 30px;
    border: 1px solid rgba(var(--wc-base-rgb), 0.4);
    border-radius: 50%;
    transition: all 0.45s var(--wc-ease);
  }

  .faq__toggle::before,
  .faq__toggle::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    background: var(--wc-base);
    transition: transform 0.45s var(--wc-ease);
  }

  .faq__toggle::before {
    width: 12px;
    height: 2px;
    transform: translate(-50%, -50%);
  }

  .faq__toggle::after {
    width: 2px;
    height: 12px;
    transform: translate(-50%, -50%);
  }

  summary:hover .faq__toggle {
    border-color: var(--wc-base);
    background: rgba(var(--wc-base-rgb), 0.1);
  }

  details[open] .faq__toggle {
    border-color: var(--wc-base);
    background: var(--wc-base);
  }

  details[open] .faq__toggle::before,
  details[open] .faq__toggle::after {
    background: #fff;
  }

  details[open] .faq__toggle::after {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0);
  }

  details p {
    margin: 0 0 26px;
    color: var(--wc-gray);
    font-size: 15.5px;
    line-height: 1.7;
    max-width: 62ch;
    translate: 0 -8px;
    opacity: 0;
    transition:
      translate 0.55s var(--wc-ease),
      opacity 0.55s ease;
  }

  details[open] p {
    translate: 0 0;
    opacity: 1;
  }

  .faq-cta {
    position: relative;
    padding: var(--section-pad) 0;
    background: var(--wc-primary);
    text-align: center;
  }

  .faq-cta__inner {
    max-width: 40rem;
    margin-inline: auto;
  }

  .faq-cta .section-title__tagline {
    margin-bottom: 14px;
  }

  .faq-cta .section-title__title {
    margin: 0 0 14px;
  }

  .faq-cta p {
    margin: 0 auto;
    color: var(--wc-gray);
    font-size: 16px;
    line-height: 1.65;
    max-width: 40ch;
  }

  .faq-cta .cta-row {
    justify-content: center;
  }
</style>