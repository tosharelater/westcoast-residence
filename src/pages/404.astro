---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/paths';
import { whatsappUrl } from '../data/site';
---

<BaseLayout
  title="Page introuvable"
  description="La page demandée n'existe pas sur West Coast Residence."
>
  <section class="error-page">
    <div class="error-page__bg" aria-hidden="true">
      <img src={withBase('/images/hero-facade.jpg')} alt="" />
    </div>
    <div class="error-page__shade" aria-hidden="true"></div>

    <div class="container error-page__content">
      <p class="error-page__code">404</p>
      <h1>Cette page n'existe pas</h1>
      <p class="error-page__text">
        Le lien est peut-être ancien, ou la page a été déplacée. Revenez à
        l'accueil ou contactez-nous directement.
      </p>

      <div class="cta-row">
        <a class="thm-btn thm-btn--base" href={withBase('/')}>Retour à l'accueil</a>
        <a class="thm-btn thm-btn--ghost" href={withBase('/programme')}>
          Voir le programme
        </a>
        <a
          class="thm-btn thm-btn--whatsapp"
          href={whatsappUrl()}
          target="_blank"
          rel="noopener noreferrer"
        >
          WhatsApp
        </a>
      </div>

      <nav class="error-page__links" aria-label="Raccourcis">
        <a href={withBase('/appartements')}>Appartements</a>
        <a href={withBase('/commerces')}>Commerces</a>
        <a href={withBase('/bureaux')}>Bureaux</a>
        <a href={withBase('/contact')}>Contact</a>
      </nav>
    </div>
  </section>
</BaseLayout>

<style>
  .error-page {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: center;
    overflow: hidden;
    color: #fff;
  }

  .error-page__bg,
  .error-page__shade {
    position: absolute;
    inset: 0;
  }

  .error-page__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.06);
    filter: saturate(0.9);
  }

  .error-page__shade {
    background:
      linear-gradient(
        180deg,
        rgba(20, 17, 14, 0.72) 0%,
        rgba(20, 17, 14, 0.55) 45%,
        rgba(20, 17, 14, 0.88) 100%
      );
  }

  .error-page__content {
    position: relative;
    z-index: 1;
    padding: calc(var(--nav-h) + 3rem) 0 4rem;
    max-width: 720px;
    animation: errorIn 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .error-page__code {
    margin: 0 0 0.5rem;
    font-family: var(--wc-font-display);
    font-size: clamp(4.5rem, 14vw, 8rem);
    line-height: 0.9;
    letter-spacing: 0.04em;
    color: var(--wc-base);
    opacity: 0.95;
  }

  .error-page h1 {
    color: #fff;
    font-size: clamp(2rem, 4.5vw, 3.2rem);
    margin-bottom: 0.85rem;
  }

  .error-page__text {
    color: rgba(255, 255, 255, 0.78);
    font-size: 1.05rem;
    max-width: 34rem;
    margin: 0 0 0.5rem;
  }

  .error-page .cta-row {
    margin-top: 1.75rem;
  }

  .error-page__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem 1.35rem;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }

  .error-page__links a {
    font-size: 0.92rem;
    color: rgba(255, 255, 255, 0.72);
    letter-spacing: 0.02em;
  }

  .error-page__links a:hover {
    color: var(--wc-base);
  }

  @keyframes errorIn {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
