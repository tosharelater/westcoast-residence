---
import { withBase } from '../utils/paths';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ContactForm from '../components/ContactForm.astro';
import MapSection from '../components/MapSection.astro';
import { site, whatsappUrl } from '../data/site';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'West Coast Residence',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Boulevard Hassan II',
    addressLocality: 'Mohammedia',
    addressCountry: 'MA',
  },
  url: `${site.url}/contact`,
  email: site.email,
  telephone: site.phone,
  image: `${site.url}/images/hero-facade.webp`,
  geo: {
    '@type': 'GeoCoordinates',
    latitude: site.geo.latitude,
    longitude: site.geo.longitude,
  },
  openingHours: 'Mo-Sa 10:00-19:00',
};
---

<BaseLayout
  title="Contact, West Coast Residence Mohammedia"
  description="Contactez West Coast Residence à Mohammedia : formulaire, WhatsApp, adresse et horaires de visite. Réponse rapide garantie."
  schema={schema}
>
  <PageHero
    title="Contactez-nous"
    subtitle="Une question, une visite à organiser ? On vous répond rapidement, en priorité sur WhatsApp."
    image={withBase("/images/stairs.webp")}
    alt="Contact West Coast Residence"
    compact
  >
    <div class="cta-row">
      <a
        class="thm-btn thm-btn--whatsapp"
        href={whatsappUrl()}
        target="_blank"
        rel="noopener noreferrer"
      >
        Écrire sur WhatsApp
      </a>
    </div>
  </PageHero>

  <ContactForm pageSource="contact" overlap />

  <MapSection overlap />
</BaseLayout>
