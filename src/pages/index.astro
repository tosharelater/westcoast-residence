---
import { withBase } from '../utils/paths';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import MapSection from '../components/MapSection.astro';
import {
  advantages,
  blogPosts,
  typologies,
  whatsappUrl,
} from '../data/site';

const slides = [
  {
    image: withBase('/images/hero-facade.webp'),
    title: 'Appartements et Studios\nà Vendre à Mohammedia',
    badge: 'Déjà livré',
    sub: "Studios, appartements familiaux, bureaux et commerces. Visitez cette semaine, sans attendre la fin d'un chantier.",
    isH1: true,
  },
  {
    image: withBase('/images/stairs.webp'),
    title: 'Finitions soignées\nMarbre & Verrières',
    badge: 'R+4',
    sub: 'Deux immeubles, Bd Hassan II',
    isH1: false,
  },
  {
    image: withBase('/images/bedroom.webp'),
    title: 'Studios dès\n500 000 DH',
    badge: '36–53 m²',
    sub: 'Aide Daam Sakane possible',
    isH1: false,
  },
];

const counters = [
  { value: 2, label: 'Immeubles', icon: 'building' },
  { value: 4, label: 'Étages (R+4)', icon: 'layers' },
  { value: 114, label: 'm² max logements', icon: 'area' },
  { value: 70000, unit: 'DH', label: 'aide au logement', icon: 'tag' },
];

const counterIcons: Record<string, string> = {
  building:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21h18"/><path d="M5 21V5a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v16"/><path d="M13 9h5a1 1 0 0 1 1 1v11"/><path d="M8 8h2M8 12h2M8 16h2M16 13h1M16 17h1"/></svg>',
  layers:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2l10 5.5L12 13 2 7.5 12 2z"/><path d="M2 12.5L12 18l10-5.5"/><path d="M2 17.5L12 23l10-5.5"/></svg>',
  area:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="1"/><path d="M8 3v4M3 8h4M16 21v-4M21 16h-4"/></svg>',
  tag:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.6 13.4 11 3.8a2 2 0 0 0-1.4-.6H4a2 2 0 0 0-2 2v5.6c0 .5.2 1 .6 1.4l9.6 9.6a2 2 0 0 0 2.8 0l5.6-5.6a2 2 0 0 0 0-2.8z"/><circle cx="7.5" cy="7.5" r="1.2"/></svg>',
};

const tagIcon = counterIcons.tag;

const postDateMeta = (date: string) => {
  const parts = date.split('-').map((n) => Number(n) || 1);
  const month = parts[1] ?? 1;
  const day = parts[2] ?? 1;
  const months = [
    'Jan', 'Fév', 'Mar', 'Avr', 'Mai', 'Juin',
    'Juil', 'Août', 'Sep', 'Oct', 'Nov', 'Déc',
  ];
  return {
    day: String(day).padStart(2, '0'),
    month: months[Math.min(Math.max(month, 1), 12) - 1] ?? 'Jan',
  };
};

const gallery = [
  { src: withBase('/images/facade-angle.webp'), alt: 'Façade West Coast Residence', tall: true },
  { src: withBase('/images/hall.webp'), alt: 'Hall West Coast Residence' },
  { src: withBase('/images/interior-22.webp'), alt: 'Salon appartement' },
  { src: withBase('/images/bathroom.webp'), alt: 'Salle de bain' },
  { src: withBase('/images/commerce.webp'), alt: 'Commerces rez-de-chaussée' },
  { src: withBase('/images/interior-08.webp'), alt: 'Intérieur studio' },
];

const posts = blogPosts.slice(0, 3);
const whyPoints = advantages.slice(0, 6);
---

<BaseLayout
  title="Appartements & Studios à Vendre à Mohammedia"
  description="Résidence neuve déjà livrée à Mohammedia : studios, appartements, bureaux et commerces disponibles. Visitez cette semaine, écrivez-nous sur WhatsApp."
  preloadImage="/images/hero-facade.webp"
>
  <!-- MAIN SLIDER -->
  <section class="main-slider" data-hero-slider>
    <div class="main-slider__track">
      {
        slides.map((slide, i) => (
          <div class:list={['main-slider__slide', { 'is-active': i === 0 }]} data-slide>
            <div class="main-slider__layer">
              <img
                src={slide.image}
                alt=""
                width="1600"
                height="1067"
                decoding={i === 0 ? 'sync' : 'async'}
                fetchpriority={i === 0 ? 'high' : 'low'}
                loading={i === 0 ? 'eager' : 'lazy'}
              />
            </div>
            <div class="main-slider__overlay" />
            <div class="main-slider__content">
              {slide.isH1 ? (
                <h1
                  class="main-slider__title"
                  set:html={slide.title.replace('\n', '<br />')}
                />
              ) : (
                <p
                  class="main-slider__title"
                  set:html={slide.title.replace('\n', '<br />')}
                />
              )}
              <p class="main-slider__sub">
                <span>{slide.badge}</span>
                {slide.sub}
              </p>
              <div class="main-slider__actions cta-row">
                <a
                  class="thm-btn thm-btn--base"
                  href={whatsappUrl()}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  WhatsApp
                </a>
                <a class="thm-btn thm-btn--ghost" href={withBase('/programme')}>
                  Voir le programme
                </a>
              </div>
            </div>
          </div>
        ))
      }
    </div>
    <div class="main-slider__nav">
      <button type="button" aria-label="Précédent" data-hero-prev>‹</button>
      <button type="button" aria-label="Suivant" data-hero-next>›</button>
    </div>
  </section>

  <!-- ABOUT -->
  <section class="about-one">
<img class="about-one__deco float-bob-y" src={withBase("/theme/about-one-shape-2.webp")} alt="" width="320" height="320" decoding="async" loading="lazy" />
      <div class="container about-one__grid">
      <div class="about-one__media reveal-left">
        <span class="about-one__watermark">West Coast</span>
        <img class="main" src={withBase("/images/facade-angle.webp")} alt="West Coast Residence Mohammedia" width="1600" height="1067" decoding="async" loading="lazy" />
        <img class="about-one__shape float-bob-x" src={withBase("/theme/about-one-shape-1.webp")} alt="" width="120" height="120" decoding="async" loading="lazy" />
      </div>
      <div class="reveal">
        <div class="section-title">
          <span class="section-title__tagline">Notre résidence</span>
          <h2 class="section-title__title">Un bien pour chaque projet à Mohammedia</h2>
        </div>
        <p class="about-one__lead">Résidence déjà livrée — zéro attente chantier</p>
        <p>
          Studios, appartements familiaux, bureaux et commerces dans une résidence terminée
          Boulevard Hassan II. Ce que vous visitez, c’est ce que vous achetez.
        </p>
        <div class="about-points">
          <article>
            <h3>Mixité intelligente</h3>
            <p>Logements, commerces et bureaux réunis pour une vraie vie de quartier.</p>
          </article>
          <article>
            <h3>Finitions premium</h3>
            <p>Marbre, verrières, façade moderne — un niveau de détail pensé pour durer.</p>
          </article>
        </div>
        <div class="cta-row">
          <a class="thm-btn" href={withBase("/programme")}>Plus de détails</a>
        </div>
      </div>
    </div>
  </section>

  <!-- COUNTERS -->
  <div class="counter-one">
    <div
      class="counter-one__bg"
      style={`background-image:url('${withBase('/theme/counter-one-bg-img-1.webp')}')`}
    ></div>
    <div class="container counter-one__grid">
      {
        counters.map((c, i) => (
          <div class="counter-one__item reveal" style={`transition-delay:${i * 80}ms`}>
            <div class="counter-one__single">
              <div class="counter-one__top">
                <div class="counter-one__shape" />
                <div class="counter-one__icon" set:html={counterIcons[c.icon] ?? ''} />
              </div>
              <div class="counter-one__count-box">
                <div class="counter-one__number">
                  <span data-count={c.value}>0</span>
                  {c.unit && <span class="counter-one__unit">{c.unit}</span>}
                </div>
                <p class="counter-one__label">{c.label}</p>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <!-- WHY CHOOSE -->
  <section class="why-one">
    <div
      class="why-one__bg"
      data-parallax
      style={`background-image:url('${withBase('/images/stairs.webp')}')`}
    ></div>
    <img class="why-one__shape float-bob-y" src={withBase("/theme/why-choose-one-shape-2.webp")} alt="" width="240" height="240" decoding="async" loading="lazy" />
    <div class="container why-one__inner">
      <div class="reveal">
        <h2>Pourquoi choisir West Coast Residence ?</h2>
      </div>
      <ul class="why-one__points reveal">
        {
          whyPoints.map((item) => (
            <li>
              <span>✓</span>
              {item.title}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- APARTMENTS / TYPOLOGIES -->
  <section class="apartment-one">
    <div
      class="apartment-one__bg"
      style={`background-image:url('${withBase('/theme/apartment-one-bg.webp')}')`}
    ></div>
    <div class="container container--wide">
      <div class="section-title section-title--center reveal">
        <span class="section-title__tagline">Typologies</span>
        <h2 class="section-title__title">Choisissez votre bien</h2>
      </div>
      <div class="apartment-grid">
        {
          typologies.map((item, i) => (
            <a
              class="apartment-card reveal"
              href={item.href}
              style={`transition-delay:${i * 90}ms`}
            >
              <div class="apartment-card__img">
                <img src={item.image} alt={item.alt} width="900" height="1200" loading="lazy" decoding="async" />
              </div>
              <span class="apartment-card__badge">{item.surface}</span>
              <div class="apartment-card__body">
                <h3>
                  {item.title}
                  <br />
                  {item.price}
                </h3>
                <span class="apartment-card__arrow" aria-hidden="true">→</span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- GALLERY -->
  <section class="gallery-one">
    <div class="container">
      <div class="section-title section-title--center reveal">
        <span class="section-title__tagline">Galerie</span>
        <h2 class="section-title__title">West Coast en images</h2>
      </div>
      <div class="gallery-grid">
        {
          gallery.map((g, i) => (
            <div
              class:list={['gallery-item', 'reveal', { 'gallery-item--tall': g.tall }]}
              style={`transition-delay:${i * 60}ms`}
            >
              <img src={g.src} alt={g.alt} width="1200" height="900" loading="lazy" decoding="async" />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- BLOG -->
  <section class="section">
    <div class="container">
      <div class="section-title section-title--center reveal">
        <span class="section-title__tagline">Guides</span>
        <h2 class="section-title__title">Bien acheter à Mohammedia</h2>
      </div>
      <div class="news-grid">
        {
          posts.map((post, i) => {
            const d = postDateMeta(post.date);
            return (
              <a
                class="news-card reveal"
                href={withBase(`/blog/${post.slug}`)}
                style={`transition-delay:${i * 80}ms`}
              >
                <div class="news-card__img-box">
                  <div class="news-card__img">
                    <img
                      src={post.image}
                      alt=""
                      width="1200"
                      height="825"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                  <div class="news-card__date">
                    <p>{d.day} {d.month}</p>
                  </div>
                  <div class="news-card__content">
                    <ul class="news-card__meta">
                      <li>
                        <span set:html={tagIcon} />
                        Guide immobilier
                      </li>
                    </ul>
                    <h3>{post.title}</h3>
                    <p class="news-card__excerpt">{post.excerpt}</p>
                    <div class="news-card__bottom">
                      <span class="news-card__button">Lire l'article →</span>
                    </div>
                  </div>
                </div>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>

  <ContactForm pageSource="accueil" overlap />

  <MapSection overlap />
</BaseLayout>

<script>
  const root = document.querySelector('[data-hero-slider]');
  if (root) {
    const slides = Array.from(root.querySelectorAll('[data-slide]'));
    let index = 0;
    let timer = 0;

    const show = (next: number) => {
      slides[index]?.classList.remove('is-active');
      index = (next + slides.length) % slides.length;
      slides[index]?.classList.add('is-active');
    };

    const play = () => {
      window.clearInterval(timer);
      timer = window.setInterval(() => show(index + 1), 5500);
    };

    root.querySelector('[data-hero-next]')?.addEventListener('click', () => {
      show(index + 1);
      play();
    });
    root.querySelector('[data-hero-prev]')?.addEventListener('click', () => {
      show(index - 1);
      play();
    });
    play();
  }
</script>
