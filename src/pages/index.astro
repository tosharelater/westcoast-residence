---
import { withBase } from '../utils/paths';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import KeyFigures from '../components/KeyFigures.astro';
import MapSection from '../components/MapSection.astro';
import {
  advantages,
  blogPosts,
  site,
  typologies,
  whatsappUrl,
} from '../data/site';
import {
  iconDrop,
  iconLayers,
  iconTag,
} from '../utils/icons';

// Le texte du hero vient du brief de contenu et reste FIXE ; seules les images défilent.
const heroImages = [
  withBase('/images/hall.webp'),
  withBase('/images/hero-facade.webp'),
  withBase('/images/facade-angle.webp'),
  withBase('/images/interior-33.webp'),
  withBase('/images/stairs.webp'),
  withBase('/images/bedroom.webp'),
];
const heroTitle = 'Appartements et Studios à Vendre à Mohammedia';
const heroBadge = 'Déjà livré';
const heroSub =
  'Studios, appartements familiaux, bureaux et commerces, dans une résidence déjà livrée. Visitez cette semaine, sans attendre la fin d\u2019un chantier.';

const steps = [
  {
    num: '01',
    drift: '0.34',
    title: 'Contact',
    text: "Écrivez-nous sur WhatsApp ou remplissez le formulaire, réponse rapide.",
  },
  {
    num: '02',
    drift: '0.22',
    title: 'Visite',
    text: "Le bien est déjà livré : vous visitez le logement, bureau ou commerce réel, pas une maquette ni un plan.",
  },
  {
    num: '03',
    drift: '0.1',
    title: 'Signature chez le notaire',
    text: "Une fois décidé, signature directement chez le notaire, remise des clés immédiate.",
  },
];

const postDateMeta = (date: string) => {
  const parts = date.split('-').map((n) => Number(n) || 1);
  const month = parts[1] ?? 1;
  const day = parts[2] ?? 1;
  const months = [
    'Jan', 'Fév', 'Mar', 'Avr', 'Mai', 'Juin',
    'Juil', 'Août', 'Sep', 'Oct', 'Nov', 'Déc',
  ];
  return {
    day: String(day).padStart(2, '0'),
    month: months[Math.min(Math.max(month, 1), 12) - 1] ?? 'Jan',
  };
};

const gallery = [
  { src: withBase('/images/hero-facade.webp'), alt: 'Façade West Coast Residence', tall: true },
  { src: withBase('/images/stairs.webp'), alt: 'Escalier marbre West Coast Residence' },
  { src: withBase('/images/interior-27.webp'), alt: 'Salon appartement' },
  { src: withBase('/images/bedroom.webp'), alt: 'Chambre West Coast Residence' },
  { src: withBase('/images/commerce.webp'), alt: 'Commerces rez-de-chaussée' },
  { src: withBase('/images/hall.webp'), alt: 'Hall West Coast Residence' },
  { src: withBase('/images/interior-45.webp'), alt: 'Séjour lumineux West Coast Residence', wide: true },
];

const posts = blogPosts.slice(0, 3);
const whyPoints = advantages.slice(0, 6);
---

<BaseLayout
  title="Appartements & Studios à Vendre à Mohammedia"
  description="Résidence neuve déjà livrée à Mohammedia : studios, appartements, bureaux et commerces disponibles. Visitez cette semaine, écrivez-nous sur WhatsApp."
  preloadImage="/images/hall.webp"
>
  <!-- MAIN SLIDER -->
  <section class="main-slider" data-hero-slider>
    <div class="main-slider__track">
      {
        heroImages.map((image, i) => (
          <div class:list={['main-slider__slide', { 'is-active': i === 0 }]} data-slide>
            <div class="main-slider__layer">
              <img
                src={image}
                alt=""
                width="1600"
                height="1067"
                decoding={i === 0 ? 'sync' : 'async'}
                fetchpriority={i === 0 ? 'high' : 'low'}
                loading={i === 0 ? 'eager' : 'lazy'}
              />
            </div>
            <div class="main-slider__overlay" />
          </div>
        ))
      }
    </div>
    <!-- Texte fixe (brief de contenu) — les images défilent derrière -->
    <div class="main-slider__content">
      <h1 class="main-slider__title" set:html={heroTitle.replace('\n', '<br />')} />
      <p class="main-slider__sub">
        <span>{heroBadge}</span>
        {heroSub}
      </p>
      <div class="main-slider__actions cta-row">
        <a
          class="thm-btn thm-btn--base"
          href={whatsappUrl()}
          target="_blank"
          rel="noopener noreferrer"
        >
          Discuter maintenant
        </a>
        <a class="thm-btn thm-btn--ghost" href={withBase('/programme')}>
          Voir le programme
        </a>
      </div>
    </div>
    <div class="main-slider__nav">
      <button type="button" aria-label="Précédent" data-hero-prev>‹</button>
      <button type="button" aria-label="Suivant" data-hero-next>›</button>
    </div>
  </section>

  <!-- ABOUT -->
  <section class="about-one">
    <div class="container about-one__grid">
      <div class="about-one__media reveal-left">
        <span class="about-one__watermark">West Coast</span>
        <img class="main" src={withBase("/images/facade-angle.webp")} alt="West Coast Residence Mohammedia" width="1600" height="1067" decoding="async" loading="lazy" />
        </div>
      <div class="reveal">
        <div class="section-title">
          <span class="section-title__tagline">Notre résidence</span>
          <h2 class="section-title__title">Un bien pour chaque projet à Mohammedia</h2>
        </div>
        <p class="about-one__lead">Résidence déjà livrée — zéro attente chantier</p>
        <p>
          Studios, appartements familiaux, bureaux et commerces dans une résidence terminée
          Boulevard Hassan II. Ce que vous visitez, c’est ce que vous achetez.
        </p>
        <div class="about-points">
          <article>
            <h3>Mixité intelligente</h3>
            <p>Logements, commerces et bureaux réunis pour une vraie vie de quartier.</p>
          </article>
          <article>
            <h3>Finitions premium</h3>
            <p>Marbre, verrières, façade moderne — un niveau de détail pensé pour durer.</p>
          </article>
        </div>
        <div class="cta-row">
          <a class="thm-btn" href={withBase("/programme")}>Plus de détails</a>
        </div>
      </div>
    </div>
  </section>

  <!-- APARTMENTS / TYPOLOGIES -->
  <section class="apartment-one">
    <div class="container container--wide">
      <div class="section-title section-title--center reveal">
        <span class="section-title__tagline">Typologies</span>
        <h2 class="section-title__title">Un bien pour chaque projet</h2>
      </div>
      <p class="apartment-one__lead reveal">
        Pour professionnels comme pour particuliers, chaque typologie répond à un projet précis
        — du PME au commerçant, du studio au bureau. Résidence déjà livrée et immédiatement habitable.
      </p>
      <div class="apartment-grid">
        {
          typologies.map((item, i) => (
            <a
              class="apartment-card reveal"
              href={item.href}
              style={`transition-delay:${i * 90}ms`}
            >
              <div class="apartment-card__img">
                <img src={item.image} alt={item.alt} width="900" height="1200" loading="lazy" decoding="async" />
              </div>
              <div class="apartment-card__body">
                <div>
                  <h3>{item.title}</h3>
                  <p class="apartment-card__hook">{item.hook}</p>
                </div>
                <span class="apartment-card__arrow" aria-hidden="true">→</span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CHIFFRES CLÉS -->
  <KeyFigures />

  <!-- WHY CHOOSE -->
  <section class="why-one">
    <div
      class="why-one__bg"
      data-parallax
      style={`background-image:url('${withBase('/images/stairs.webp')}')`}
    ></div>
    <div class="container why-one__inner">
      <div class="why-one__head reveal">
        <span class="section-title__tagline">Nos atouts</span>
        <h2>Pourquoi choisir West Coast Residence ?</h2>
        <p class="why-one__note">
          Six raisons concrètes, dans une résidence qui existe déjà.
        </p>
        <div class="cta-row">
          <a
            class="thm-btn thm-btn--base"
            href={whatsappUrl()}
            target="_blank"
            rel="noopener noreferrer"
          >
            Poser une question
          </a>
        </div>
      </div>
      <ol class="why-one__list reveal">
        {
          whyPoints.map((item, i) => (
            <li class="why-one__item" style={`transition-delay:${i * 70}ms`}>
              <span class="why-one__num">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- PARCOURS D'ACHAT -->
  <section class="section section--primary">
    <div class="container">
      <div class="section-title section-title--center reveal">
        <span class="section-title__tagline">Votre achat</span>
        <h2 class="section-title__title">Un parcours simple, en 3 étapes</h2>
      </div>
      <ol class="steps">
        {
          steps.map((step) => (
            <li class="step">
              <span class="step__num" data-parallax-num={step.drift}>
                {step.num}
              </span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))
        }
      </ol>
      <div class="cta-row steps__cta">
        <a
          class="thm-btn thm-btn--base"
          href={whatsappUrl()}
          target="_blank"
          rel="noopener noreferrer"
        >
          Organiser une visite
        </a>
      </div>
    </div>
  </section>

  <!-- GALLERY -->
  <section class="gallery-one section--tight-bottom">
    <div class="container">
      <div class="section-title section-title--center reveal">
        <span class="section-title__tagline">Galerie</span>
        <h2 class="section-title__title">West Coast en images</h2>
      </div>
      <div class="gallery-grid">
        {
          gallery.map((g, i) => (
            <div
              class:list={['gallery-item', 'reveal', { 'gallery-item--tall': g.tall, 'gallery-item--wide': g.wide }]}
              style={`transition-delay:${i * 60}ms`}
            >
              <img src={g.src} alt={g.alt} width="1200" height="900" loading="lazy" decoding="async" />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- BLOG -->
  <section class="section section--tight-top section--tight-bottom">
    <div class="container">
      <div class="section-title section-title--center reveal">
        <span class="section-title__tagline">Guides</span>
        <h2 class="section-title__title">Nos guides pour bien acheter à Mohammedia</h2>
      </div>
      <div class="news-grid">
        {
          posts.map((post, i) => {
            const d = postDateMeta(post.date);
            return (
              <a
                class="news-card reveal"
                href={withBase(`/blog/${post.slug}`)}
                style={`transition-delay:${i * 80}ms`}
              >
                <div class="news-card__img-box">
                  <div class="news-card__img">
                    <img
                      src={post.image}
                      alt=""
                      width="1200"
                      height="825"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                  <div class="news-card__date">
                    <p>{d.day} {d.month}</p>
                  </div>
                  <div class="news-card__content">
                    <ul class="news-card__meta">
                      <li>
                        <span set:html={iconTag} />
                        Guide immobilier
                      </li>
                    </ul>
                    <h3>{post.title}</h3>
                    <p class="news-card__excerpt">{post.excerpt}</p>
                    <div class="news-card__bottom">
                      <span class="news-card__button">Lire l'article →</span>
                    </div>
                  </div>
                </div>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- LOCALISATION -->
  <section class="section loc-section section--tight-top">
    <div class="container split">
      <div class="reveal">
        <div class="section-title">
          <span class="section-title__tagline">Localisation</span>
          <h2 class="section-title__title">Mohammedia, bien placé sur l'axe Casa-Rabat</h2>
        </div>
        <p class="loc-section__lead">
          Mohammedia offre un bon compromis entre calme et accessibilité, à
          proximité de Casablanca et sur l'axe vers Rabat. West Coast Residence
          se trouve Boulevard Hassan II.
        </p>
        <div class="cta-row">
          <a
            class="thm-btn thm-btn--base"
            href={site.mapsLink}
            target="_blank"
            rel="noopener noreferrer"
          >
            Itinéraire sur Google Maps
          </a>
        </div>
      </div>
      <aside class="loc-card reveal">
        <div class="loc-card__head">
          <span class="loc-card__kicker">Adresse</span>
          <p class="loc-card__address">
            <a href={site.mapsLink} target="_blank" rel="noopener noreferrer"
              >{site.address}</a
            >
          </p>
        </div>
        <ul class="loc-card__list">
          <li>
            <span class="loc-card__icon" set:html={iconLayers} />
            <div>
              <strong>Axe Casa–Rabat</strong>
              <p>Accès rapide à Casablanca et Rabat depuis le Bd Hassan II.</p>
            </div>
          </li>
          <li>
            <span class="loc-card__icon" set:html={iconDrop} />
            <div>
              <strong>À proximité</strong>
              <p>Plages et centre-ville de Mohammedia.</p>
            </div>
          </li>
        </ul>
      </aside>
    </div>
  </section>

  <MapSection />

  <ContactForm pageSource="accueil" whatsappLabel="Réponse rapide" />
</BaseLayout>

<script>
  const root = document.querySelector('[data-hero-slider]');
  if (root) {
    const slides = Array.from(root.querySelectorAll('[data-slide]'));
    let index = 0;
    let timer = 0;

    const show = (next: number) => {
      slides[index]?.classList.remove('is-active');
      index = (next + slides.length) % slides.length;
      slides[index]?.classList.add('is-active');
    };

    const play = () => {
      window.clearInterval(timer);
      timer = window.setInterval(() => show(index + 1), 5500);
    };

    root.querySelector('[data-hero-next]')?.addEventListener('click', () => {
      show(index + 1);
      play();
    });
    root.querySelector('[data-hero-prev]')?.addEventListener('click', () => {
      show(index - 1);
      play();
    });
    play();
  }

  const stepsRoot = document.querySelector('.steps');
  if (stepsRoot) {
    document.documentElement.classList.add('steps-js');
    const steps = Array.from(stepsRoot.querySelectorAll('.step'));
    let ticking = false;

    const update = () => {
      ticking = false;
      const desk = window.innerWidth >= 900;
      const rect = stepsRoot.getBoundingClientRect();
      const vh = window.innerHeight;
      const total = rect.height + vh * 0.5;
      let p = (vh - rect.top + vh * 0.15) / total;
      p = Math.max(0, Math.min(1, p));

      steps.forEach((el, i) => {
        const seg = Math.max(0, Math.min(1, p * steps.length - i));
        const rise = (1 - seg) * 44;
        const base = desk ? i * 48 : 0;
        const y = base + rise;
        el.style.opacity = String(seg);
        el.style.transform = `translateY(${y.toFixed(1)}px)`;
      });
    };

    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        window.requestAnimationFrame(update);
      }
    };

    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
  }
</script>