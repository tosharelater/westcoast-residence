---
import { withBase } from '../utils/paths';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ContactForm from '../components/ContactForm.astro';
import MapSection from '../components/MapSection.astro';
import { whatsappUrl } from '../data/site';
import {
  iconArrowOut,
  iconDrop,
  iconScales,
  iconStore,
  iconTag,
  iconWindow,
} from '../utils/icons';
---

<BaseLayout
  title="Local Commercial à Vendre à Mohammedia"
  description="Commerces de 58 à 119 m² en pied d'immeuble à Mohammedia, résidence déjà livrée. Emplacement passant, disponibilité immédiate. Contactez-nous."
  whatsappMessage="Bonjour, je m'intéresse aux commerces de West Coast Residence à Mohammedia."
>
  <PageHero
    title="Local Commercial à Vendre à Mohammedia"
    subtitle="Des commerces en pied d'immeuble, dans une résidence déjà livrée, sur un axe passant."
    image={withBase("/images/commerce.webp")}
    alt="Commerces vitrés West Coast Residence Mohammedia"
  >
    <div class="cta-row">
      <a
        class="thm-btn thm-btn--base"
        href={whatsappUrl(
          'Bonjour, je souhaite demander une visite pour un local commercial à West Coast Residence.'
        )}
        target="_blank"
        rel="noopener noreferrer"
      >
        Demander une visite
      </a>
    </div>
  </PageHero>

  <section class="section section--primary">
    <div class="container proof-panel reveal">
      <div class="section-title">
        <span class="section-title__tagline">Preuve de valeur</span>
        <h2 class="section-title__title">Un emplacement qui a déjà convaincu</h2>
      </div>
      <p class="proof-panel__text">
        Un commerce de West Coast Residence a déjà été vendu à plus de
        <strong>2 200 000 DH</strong>. La preuve que l'emplacement attire, avant
        même la fin de la commercialisation, sur un total de seulement
        <strong>8 commerces</strong> disponibles dans tout le programme.
      </p>
      <a class="content-block__link" href={withBase("/blog/investir-mohammedia")}>
        Lire : investir à Mohammedia →
      </a>
    </div>
  </section>

  <section class="section">
    <div class="container content-block">
      <div class="media-frame content-block__media reveal">
        <img
          src={withBase("/images/facade-angle.webp")}
          alt="Façade commerces West Coast Residence"
          loading="lazy"
         width="1600" height="1067" decoding="async" />
      </div>
      <div class="content-block__copy reveal">
        <div class="section-title">
          <span class="section-title__tagline">Le produit</span>
          <h2 class="section-title__title">Des surfaces de 58 à 119 m²</h2>
        </div>
        <ul class="list-check">
          <li>Vitrine en pied d'immeuble</li>
          <li>8 commerces disponibles au total</li>
          <li>Livraison immédiate, aucun délai</li>
          <li>
            Adapté à tout commerce de proximité (restauration, services,
            commerces de détail)
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- CARACTÉRISTIQUES TECHNIQUES -->
  <section class="section section--primary">
    <div class="container">
      <div class="section-title reveal">
        <span class="section-title__tagline">Fiche technique</span>
        <h2 class="section-title__title">Des locaux prêts à exploiter</h2>
      </div>
      <ul class="icon-list icon-list--duo reveal">
        <li>
          <span class="icon" set:html={iconWindow} />
          <div>
            <strong>Vitrine sur rue</strong>
            <p>Visibilité directe depuis le Bd Hassan II.</p>
          </div>
        </li>
        <li>
          <span class="icon" set:html={iconDrop} />
          <div>
            <strong>Eau et électricité en place</strong>
            <p>Arrivées prêtes, raccordement immédiat.</p>
          </div>
        </li>
        <li>
          <span class="icon" set:html={iconArrowOut} />
          <div>
            <strong>Accès dédié</strong>
            <p>Entrée indépendante des parties résidentielles.</p>
          </div>
        </li>
      </ul>
      <p class="icon-list__fine">
        Hauteur sous plafond et puissance électrique à confirmer local par local
        : le détail complet se donne sur place, lors de la visite.
      </p>
    </div>
  </section>

  <!-- ACTIVITÉS ADAPTÉES -->
  <section class="section">
    <div class="container">
      <div class="section-title reveal">
        <span class="section-title__tagline">Usages</span>
        <h2 class="section-title__title">Quel commerce installer ici ?</h2>
      </div>
      <ul class="tag-list reveal">
        <li>Commerce de proximité : supérette, boulangerie, pressing</li>
        <li>Restauration rapide, café</li>
        <li>Santé : pharmacie, cabinet paramédical</li>
        <li>Services : agence, coiffure, esthétique</li>
      </ul>
    </div>
  </section>

  <section class="section section--primary feature-list-section">
    <div class="container">
      <div class="section-title reveal">
        <span class="section-title__tagline">Investissement</span>
        <h2 class="section-title__title">Un quartier vivant, pas juste un local</h2>
      </div>
      <ul class="list-check reveal">
        <li>Résidentiel + bureaux au même endroit → flux de passage garanti</li>
        <li>Zone en développement à Mohammedia</li>
        <li>Bien déjà terminé, exploitable ou louable immédiatement</li>
      </ul>
    </div>
  </section>

  <!-- RENDEMENT LOCATIF POTENTIEL -->
  <section class="section">
    <div class="container">
      <div class="section-title reveal">
        <span class="section-title__tagline">Rentabilité</span>
        <h2 class="section-title__title">Un investissement, pas juste un achat</h2>
      </div>
      <div class="info-panel reveal">
        <p class="info-panel__lead">
          Comme pour les logements, la rentabilité locative commerciale à
          Mohammedia profite d'un quartier en développement, animé dès le départ
          par la mixité de la résidence elle-même.
        </p>
        <p style="margin:0">
          <a class="content-block__link" href={withBase("/blog/investir-mohammedia")}>
            Lire : investir à Mohammedia →
          </a>
        </p>
      </div>
    </div>
  </section>

  <!-- STATUT JURIDIQUE & DOCUMENTS -->
  <section class="section section--primary">
    <div class="container">
      <div class="section-title reveal">
        <span class="section-title__tagline">Documents</span>
        <h2 class="section-title__title">Ce que vous achetez, concrètement</h2>
      </div>
      <div class="info-panel reveal">
        <ul class="icon-list">
          <li>
            <span class="icon" set:html={iconStore} />
            <div>
              <strong>Lot de copropriété à usage commercial</strong>
              <p>Bien vendu en pleine propriété, comme un lot résidentiel.</p>
            </div>
          </li>
          <li>
            <span class="icon" set:html={iconScales} />
            <div>
              <strong>Règlement de copropriété</strong>
              <p>Disponible sur demande avant toute décision.</p>
            </div>
          </li>
          <li>
            <span class="icon" set:html={iconTag} />
            <div>
              <strong>Charges communes applicables</strong>
              <p>Le montant exact vous est communiqué selon le lot visé.</p>
            </div>
          </li>
        </ul>
      </div>
      <div class="cta-row">
        <a
          class="thm-btn thm-btn--base"
          href={whatsappUrl(
            'Bonjour, je souhaite une visite pour un local commercial à West Coast Residence.'
          )}
          target="_blank"
          rel="noopener noreferrer"
        >
          Réserver une visite
        </a>
      </div>
    </div>
  </section>

  <ContactForm
    title="Réservez votre visite"
    text="Profil professionnel ou investisseur : laissez vos coordonnées et la surface recherchée."
    pageSource="commerces"
    showTypology={false}
    showSurface
    compact
    overlap
  />

  <MapSection overlap />
</BaseLayout>