---
import { withBase } from '../../utils/paths';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { blogPosts } from '../../data/site';
import { iconTag } from '../../utils/icons';

const featured = blogPosts.find((p) => p.featured) ?? blogPosts[0];
const others = blogPosts.filter((p) => p.slug !== featured.slug);
const posts = [featured, ...others];

const postDateMeta = (date: string) => {
  const parts = date.split('-').map((n) => Number(n) || 1);
  const month = parts[1] ?? 1;
  const day = parts[2] ?? 1;
  const months = [
    'Jan', 'Fév', 'Mar', 'Avr', 'Mai', 'Juin',
    'Juil', 'Août', 'Sep', 'Oct', 'Nov', 'Déc',
  ];
  return {
    day: String(day).padStart(2, '0'),
    month: months[Math.min(Math.max(month, 1), 12) - 1] ?? 'Jan',
  };
};
---

<BaseLayout
  title="Blog, Guides pour Acheter à Mohammedia"
  description="Guides et conseils pour bien acheter un bien immobilier à Mohammedia : financement, Daam Sakane, investissement, choix de typologie."
>
  <PageHero
    title="Nos guides pour bien acheter à Mohammedia"
    subtitle="Financement, choix du bien, investissement : toutes nos réponses avant de vous décider."
    image={withBase("/images/interior-33.webp")}
    alt="West Coast Residence Mohammedia"
    compact
  />

  <section class="section">
    <div class="container">
      <div class="news-grid">
        {
          posts.map((post, i) => {
            const d = postDateMeta(post.date);
            return (
              <a
                class="news-card reveal"
                href={withBase(`/blog/${post.slug}`)}
                style={`transition-delay:${i * 80}ms`}
              >
                <div class="news-card__img-box">
                  <div class="news-card__img">
                    <img
                      src={post.image}
                      alt=""
                      width="1200"
                      height="825"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                  <div class="news-card__date">
                    <p>{d.day} {d.month}</p>
                  </div>
                  <div class="news-card__content">
                    <ul class="news-card__meta">
                      <li>
                        <span set:html={iconTag} />
                        Guide immobilier
                      </li>
                    </ul>
                    <h3>{post.title}</h3>
                    <p class="news-card__excerpt">{post.excerpt}</p>
                    <div class="news-card__bottom">
                      <span class="news-card__button">Lire l'article →</span>
                    </div>
                  </div>
                </div>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>
</BaseLayout>
