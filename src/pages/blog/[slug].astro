---
import { withBase } from '../../utils/paths';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { getCollection, render } from 'astro:content';
import { getBlogCategory } from '../../data/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const image = withBase(post.data.image);
const ctaHref = withBase(post.data.ctaHref);
const category = getBlogCategory(post.data.category);

const toc = headings.filter(
  (h) => h.depth === 2 && !/^conclusion$/i.test(h.text.trim())
);

const dateLabel = new Intl.DateTimeFormat('fr-MA', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(new Date(`${post.data.date}T12:00:00`));

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.excerpt,
  datePublished: post.data.date,
  image,
  articleSection: category?.label ?? post.data.category,
  author: {
    '@type': 'Organization',
    name: 'West Coast Residence',
  },
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.excerpt}
  ogImage={image}
  schema={schema}
>
  <PageHero
    title={post.data.title}
    subtitle={post.data.excerpt}
    image={image}
    alt=""
    compact
  />

  <section class="section">
    <div class="container">
      <article class="article reveal">
        <div class="article__meta">
          {
            category && (
              <a
                class="article__cat"
                href={withBase(`/blog/categorie/${category.slug}`)}
              >
                {category.label}
              </a>
            )
          }
          <time datetime={post.data.date}>{dateLabel}</time>
        </div>

        {
          toc.length > 0 && (
            <nav class="article-toc" aria-label="Sommaire de l'article">
              <p class="article-toc__label">Dans cet article</p>
              <ul>
                {toc.map((item) => (
                  <li>
                    <a href={`#${item.slug}`}>{item.text}</a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }

        <div class="article__body">
          <Content />
        </div>

        <div class="cta-row">
          <a class="thm-btn thm-btn--base" href={ctaHref}>{post.data.ctaLabel}</a>
          <a class="thm-btn" href={withBase('/blog')}>Tous les articles</a>
        </div>
      </article>
    </div>
  </section>
</BaseLayout>
