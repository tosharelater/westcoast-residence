---
import { withBase } from '../../utils/paths';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { blogPosts } from '../../data/site';

export function getStaticPaths() {
  return blogPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;

const bodies: Record<string, string[]> = {
  'acheter-mohammedia-2026': [
    'Acheter à Mohammedia en 2026, c\'est profiter d\'un marché encore accessible sur l\'axe Casablanca–Rabat, avec une demande locative réelle et des programmes déjà livrés.',
    'Commencez par clarifier votre projet : résidence principale, premier achat, ou investissement. Ensuite, comparez les typologies disponibles et visitez des biens terminés pour éviter les retards de chantier.',
    'West Coast Residence propose studios et appartements déjà livrés Boulevard Hassan II. Vous pouvez organiser une visite cette semaine et avancer sans attendre.',
  ],
  'daam-sakane-guide': [
    'Daam Sakane est une aide de l\'État pouvant aller jusqu\'à 70 000 DH pour certains biens éligibles, notamment des lots à moins de 700 000 DH.',
    'L\'éligibilité dépend de conditions précises (premier achat, date du permis d\'habiter, profil de l\'acquéreur). Ne considérez jamais une éligibilité comme acquise avant vérification.',
    'Les studios de West Coast Residence sont souvent les typologies les plus concernées. Contactez-nous pour vérifier votre situation avant de vous décider.',
  ],
  'studio-ou-appartement': [
    'Le studio convient surtout au premier achat, à l\'investissement locatif et aux jeunes actifs : surfaces de 36 à 53 m², ticket d\'entrée dès 500 000 DH.',
    'L\'appartement familial (65 à 114 m²) répond aux besoins des familles, des résidences secondaires et des MRE qui veulent de l\'espace sans complexifier le parcours d\'achat.',
    'Comme les biens sont déjà construits, vous pouvez comparer concrètement les deux options en visite — le meilleur critère reste votre usage réel.',
  ],
  'investir-mohammedia': [
    'Mohammedia combine accessibilité depuis Casa et Rabat, un tissu urbain en développement, et un rendement locatif estimé entre 4 et 5,5% selon les typologies.',
    'Studios, petits appartements, bureaux et commerces en pied d\'immeuble offrent des angles d\'investissement différents : cash-flow, valorisation, ou exploitation professionnelle.',
    'Un commerce de West Coast Residence a déjà été vendu à plus de 2,2 M DH : un signal fort sur la valeur de l\'emplacement.',
  ],
};

const paragraphs = bodies[post.slug] ?? [post.excerpt];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.excerpt,
  datePublished: post.date,
  image: post.image,
  author: {
    '@type': 'Organization',
    name: 'West Coast Residence',
  },
};
---

<BaseLayout
  title={post.title}
  description={post.excerpt}
  ogImage={post.image}
  schema={schema}
>
  <PageHero
    title={post.title}
    subtitle={post.excerpt}
    image={post.image}
    alt=""
    compact
  />

  <section class="section">
    <div class="container article reveal">
      {
        paragraphs.map((p) => (
          <p>{p}</p>
        ))
      }
      <div class="cta-row">
        <a class="thm-btn thm-btn--base" href={post.ctaHref}>{post.ctaLabel}</a>
        <a class="thm-btn" href={withBase("/blog")}>Tous les articles</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .article {
    max-width: 720px;
  }

  .article p {
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--ink-soft);
  }
</style>
