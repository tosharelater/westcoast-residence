---
import { withBase } from '../utils/paths';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import KeyFigures from '../components/KeyFigures.astro';
import MapSection from '../components/MapSection.astro';
import ContactForm from '../components/ContactForm.astro';
import { site, whatsappUrl } from '../data/site';
import {
  iconCheck,
  iconDrop,
  iconElevator,
  iconLayers,
  iconParking,
  iconScales,
  iconShield,
  iconTerrasse,
} from '../utils/icons';

const garanties = [
  {
    icon: iconScales,
    title: "Titre foncier et permis d'habiter",
    text: 'Disponibles pour consultation avant toute décision.',
  },
  {
    icon: iconCheck,
    title: 'Accompagnement notarial',
    text: 'Nous vous accompagnons dans les démarches, de la réservation à la signature.',
  },
  {
    icon: iconShield,
    title: 'Résidence déjà réceptionnée',
    text: "Aucun risque de retard de livraison, contrairement à un achat sur plan.",
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Residence',
  name: 'West Coast Residence',
  description:
    'Résidence neuve déjà livrée à Mohammedia : appartements, studios, bureaux et commerces.',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Boulevard Hassan II',
    addressLocality: 'Mohammedia',
    addressCountry: 'MA',
  },
  url: `${site.url}/programme`,
  telephone: site.phone,
  image: `${site.url}/images/hero-facade.webp`,
  geo: {
    '@type': 'GeoCoordinates',
    latitude: site.geo.latitude,
    longitude: site.geo.longitude,
  },
};

const blocks = [
  {
    title: 'Appartements & Studios',
    surface: '36 à 114 m²',
    href: withBase('/appartements'),
    image: withBase('/images/bedroom.webp'),
    alt: 'Appartements et studios West Coast Residence Mohammedia',
  },
  {
    title: 'Commerces',
    surface: '58 à 119 m²',
    href: withBase('/commerces'),
    image: withBase('/images/commerce.webp'),
    alt: "Commerces en pied d'immeuble West Coast Residence",
  },
  {
    title: 'Bureaux',
    surface: '45 à 107 m²',
    href: withBase('/bureaux'),
    image: withBase('/images/interior-15.webp'),
    alt: 'Bureaux à vendre West Coast Residence Mohammedia',
  },
];

const equipments = [
  {
    icon: iconParking,
    text: 'Parking en sous-sol',
  },
  {
    icon: iconTerrasse,
    text: 'Terrasse commune',
  },
  {
    icon: iconElevator,
    text: 'Ascenseur',
  },
  {
    icon: iconShield,
    text: 'Accès sécurisé',
  },
];

const gallery = [
  { src: withBase('/images/facade-angle.webp'), alt: 'Façade West Coast Residence Mohammedia' },
  { src: withBase('/images/hall.webp'), alt: "Hall d'entrée West Coast Residence" },
  { src: withBase('/images/stairs.webp'), alt: 'Escalier marbre West Coast Residence' },
  { src: withBase('/images/interior-22.webp'), alt: 'Intérieur appartement West Coast Residence' },
  { src: withBase('/images/bathroom.webp'), alt: 'Salle de bain West Coast Residence' },
  { src: withBase('/images/commerce.webp'), alt: 'Commerces rez-de-chaussée West Coast Residence' },
];
---

<BaseLayout
  title="Le Programme, West Coast Residence Mohammedia"
  description="Découvrez West Coast Residence : résidence neuve déjà livrée à Mohammedia, appartements, studios, bureaux et commerces, Bd Hassan II."
  schema={schema}
  whatsappMessage="Bonjour, je souhaite en savoir plus sur le programme West Coast Residence à Mohammedia."
>
  <PageHero
    title="Une résidence déjà livrée à Mohammedia"
    subtitle="Boulevard Hassan II, Mohammedia. Deux immeubles, un seul objectif : vous permettre de vivre, travailler ou investir sans attendre."
    image={withBase("/images/facade-angle.webp")}
    alt="Façade principale West Coast Residence"
  >
    <div class="cta-row">
      <a
        class="thm-btn thm-btn--base"
        href={whatsappUrl(
          'Bonjour, je souhaite en savoir plus sur le programme West Coast Residence à Mohammedia.'
        )}
        target="_blank"
        rel="noopener noreferrer"
      >
        Écrivez-nous sur WhatsApp
      </a>
    </div>
  </PageHero>

  <section class="section">
    <div class="container content-block">
      <div class="media-frame content-block__media reveal">
        <img
          src={withBase("/images/stairs.webp")}
          alt="Espaces communs West Coast Residence Mohammedia"
          loading="lazy"
         width="1600" height="1067" decoding="async" />
      </div>
      <div class="content-block__copy reveal">
        <div class="section-title">
          <span class="section-title__tagline">Le projet</span>
          <h2 class="section-title__title">
            Un programme mixte, pensé pour la vie de quartier
          </h2>
        </div>
        <p>
          West Coast Residence est composé de deux immeubles (R+4), avec parking
          en sous-sol et terrasse commune. Le programme réunit logements,
          bureaux et commerces au même endroit, pour créer un vrai lieu de vie
          plutôt qu'un simple immeuble.
        </p>
        <div>
          <a
            class="thm-btn"
            href={whatsappUrl(
              'Bonjour, je souhaite en savoir plus sur le programme West Coast Residence à Mohammedia.'
            )}
            target="_blank"
            rel="noopener noreferrer"
          >
            Découvrir le programme
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--primary feature-list-section">
    <div class="container">
      <div class="section-title reveal">
        <span class="section-title__tagline">Différenciation</span>
        <h2 class="section-title__title">Ce qui différencie West Coast Residence</h2>
      </div>
      <ul class="list-check reveal">
        <li>Chantier entièrement livré, visite et emménagement immédiats</li>
        <li>Finitions soignées (marbre, verrières)</li>
        <li>Mixité résidentiel + commerces + bureaux</li>
        <li>Emplacement Bd Hassan II, accès facile à Casablanca et Rabat</li>
      </ul>
    </div>
  </section>

  <!-- CHIFFRES CLÉS -->
  <KeyFigures class="section--tight-bottom" />

  <section class="section section--tight-top">
    <div class="container">
      <div class="section-title reveal">
        <span class="section-title__tagline">Offre</span>
        <h2 class="section-title__title">Ce que vous pouvez acheter ici</h2>
      </div>
      <div class="offer-grid">
        {
          blocks.map((b, i) => (
            <a
              class="offer-card reveal"
              href={b.href}
              style={`transition-delay:${i * 80}ms`}
            >
              <div class="media-frame offer-card__media">
                <img src={b.image} alt={b.alt} loading="lazy"  width="1600" height="1067" decoding="async" />
              </div>
              <h3>{b.title}</h3>
              <p>{b.surface}</p>
              <span>Voir le détail →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ÉQUIPEMENTS & PRESTATIONS COMMUNES -->
  <section class="section section--primary">
    <div class="container">
      <div class="section-title reveal">
        <span class="section-title__tagline">Prestations</span>
        <h2 class="section-title__title">Ce qui est inclus dans la résidence</h2>
      </div>
      <ul class="icon-list icon-list--board reveal">
        {
          equipments.map((e, i) => (
            <li>
              <span class="icon" set:html={e.icon} />
              <div>
                <strong>{e.text}</strong>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ENVIRONNEMENT & VIE DE QUARTIER -->
  <section class="section feature-list-section">
    <div class="container">
      <div class="section-title reveal">
        <span class="section-title__tagline">Vie de quartier</span>
        <h2 class="section-title__title">Tout à proximité</h2>
      </div>
      <ul class="list-check list-check--full reveal">
        <li>Commerces et services directement intégrés au rez-de-chaussée de la résidence</li>
        <li>Accès direct au Boulevard Hassan II, axe vers Casablanca et Rabat</li>
        <li>Mohammedia : plages, centre-ville à proximité</li>
      </ul>
    </div>
  </section>

  <section class="section section--dark">
    <div class="container">
      <div class="section-title section-title--center reveal">
        <span class="section-title__tagline">Galerie</span>
        <h2 class="section-title__title">West Coast Residence en images</h2>
      </div>
      <div class="inner-gallery">
        {
          gallery.map((g, i) => (
            <div
              class="media-frame inner-gallery__item reveal"
              style={`transition-delay:${i * 60}ms`}
            >
              <img src={g.src} alt={g.alt} loading="lazy"  width="1600" height="1067" decoding="async" />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- GARANTIES & DÉMARCHES -->
  <section class="section">
    <div class="container">
      <div class="section-title reveal">
        <span class="section-title__tagline">Garanties</span>
        <h2 class="section-title__title">Un achat sécurisé</h2>
      </div>
      <ul class="icon-list icon-list--trio reveal">
        {
          garanties.map((item) => (
            <li>
              <span class="icon" set:html={item.icon} />
              <div>
                <strong>{item.title}</strong>
                <p>{item.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- PLAN DE SITUATION -->
  <section class="section section--primary loc-section">
    <div class="container split">
      <div class="reveal">
        <div class="section-title">
          <span class="section-title__tagline">Localisation</span>
          <h2 class="section-title__title">Où se trouve West Coast Residence</h2>
        </div>
        <p class="loc-section__lead">
          La résidence se situe Boulevard Hassan II, sur l'axe principal qui relie
          Casablanca à Rabat.
        </p>
        <div class="cta-row">
          <a
            class="thm-btn thm-btn--base"
            href={site.mapsLink}
            target="_blank"
            rel="noopener noreferrer"
          >
            Itinéraire sur Google Maps
          </a>
          <a class="thm-btn" href={withBase("/contact")}>Page contact</a>
        </div>
      </div>
      <aside class="loc-card reveal">
        <div class="loc-card__head">
          <span class="loc-card__kicker">Adresse</span>
          <p class="loc-card__address">{site.address}</p>
        </div>
        <ul class="loc-card__list">
          <li>
            <span class="loc-card__icon" set:html={iconLayers} />
            <div>
              <strong>Axe Casablanca–Rabat</strong>
              <p>Accès direct depuis le Bd Hassan II.</p>
            </div>
          </li>
          <li>
            <span class="loc-card__icon" set:html={iconDrop} />
            <div>
              <strong>Centre de Mohammedia</strong>
              <p>Plages, commerces et centre-ville à quelques minutes.</p>
            </div>
          </li>
        </ul>
      </aside>
    </div>
  </section>

  <MapSection />

  <ContactForm pageSource="programme" compact overlap />
</BaseLayout>