---
import { withBase } from '../utils/paths';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ContactForm from '../components/ContactForm.astro';
import MapSection from '../components/MapSection.astro';
import { whatsappUrl } from '../data/site';
import { iconCheck, iconMoney } from '../utils/icons';
---

<BaseLayout
  title="Appartements et Studios à Vendre à Mohammedia"
  description="Studios dès 500 000 DH, appartements familiaux jusqu'à 114 m². Résidence déjà livrée à Mohammedia. Visitez cette semaine, écrivez-nous sur WhatsApp."
  whatsappMessage="Bonjour, je m'intéresse aux appartements / studios de West Coast Residence à Mohammedia."
>
  <PageHero
    title="Studios et Appartements à Vendre à Mohammedia"
    subtitle="Du studio à l'appartement familial, dans une résidence déjà terminée. À partir de 500 000 DH."
    image={withBase("/images/bedroom.webp")}
    alt="Intérieur appartement West Coast Residence"
  >
    <div class="cta-row">
      <a
        class="thm-btn thm-btn--base"
        href={whatsappUrl(
          'Bonjour, je souhaite connaître les disponibilités appartements / studios à West Coast Residence.'
        )}
        target="_blank"
        rel="noopener noreferrer"
      >
        Demander les disponibilités
      </a>
    </div>
  </PageHero>

  <section class="section" id="studios">
    <div class="container content-block">
      <div class="media-frame content-block__media reveal">
        <img
          src={withBase("/images/interior-08.webp")}
          alt="Studio à vendre à Mohammedia, West Coast Residence"
          loading="lazy"
         width="1600" height="1067" decoding="async" />
      </div>
      <div class="content-block__copy reveal">
        <div class="section-title">
          <span class="section-title__tagline">Studios</span>
          <h2 class="section-title__title">Studios, à partir de 500 000 DH</h2>
        </div>
        <ul class="list-check">
          <li>Surfaces : 36 à 53 m²</li>
          <li>56 studios disponibles au total</li>
          <li>Idéal pour : premier achat, investissement locatif, jeunes actifs</li>
          <li>
            Éligible à l'aide de l'État Daam Sakane (jusqu'à 70 000 DH, sous
            conditions)
          </li>
        </ul>
        <p>
          Un studio prêt à vivre, sans travaux ni attente. Le bien existe déjà,
          vous pouvez le visiter cette semaine.
        </p>
        <a class="content-block__link" href={withBase("/blog/daam-sakane-guide")}>
          Lire le guide Daam Sakane →
        </a>
        <div>
          <a
            class="thm-btn"
            href={whatsappUrl(
              'Bonjour, je veux visiter un studio à West Coast Residence Mohammedia.'
            )}
            target="_blank"
            rel="noopener noreferrer"
          >
            Je veux visiter un studio
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--primary" id="appartements-familiaux">
    <div class="container content-block content-block--reverse">
      <div class="media-frame content-block__media reveal">
        <img
          src={withBase("/images/interior-22.webp")}
          alt="Appartement familial à vendre à Mohammedia"
          loading="lazy"
         width="1600" height="1067" decoding="async" />
      </div>
      <div class="content-block__copy reveal">
        <div class="section-title">
          <span class="section-title__tagline">Familles</span>
          <h2 class="section-title__title">
            Appartements familiaux, de 2 à 3 chambres
          </h2>
        </div>
        <ul class="list-check">
          <li>Surfaces : 65 à 114 m²</li>
          <li>16 appartements familiaux disponibles au total</li>
          <li>
            Idéal pour : familles, résidence secondaire, Marocains résidant à
            l'étranger
          </li>
        </ul>
        <p>
          Des appartements pensés pour la vie de famille, à quelques minutes des
          commerces du quartier et de la mer.
        </p>
        <div>
          <a
            class="thm-btn"
            href={whatsappUrl(
              'Bonjour, je veux visiter un appartement familial à West Coast Residence.'
            )}
            target="_blank"
            rel="noopener noreferrer"
          >
            Je veux visiter un appartement
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container reveal">
      <div class="section-title">
        <span class="section-title__tagline">Récapitulatif</span>
        <h2 class="section-title__title">Typologies disponibles</h2>
      </div>
      <div class="table-wrap">
        <table class="data">
          <thead>
            <tr>
              <th>Typologie</th>
              <th>Surfaces</th>
              <th>À partir de</th>
              <th>Disponibilité</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Studio</td>
              <td>36–53 m²</td>
              <td>500 000 DH</td>
              <td>56 unités</td>
            </tr>
            <tr>
              <td>Appartement 2–3 chambres</td>
              <td>65–114 m²</td>
              <td>sur demande</td>
              <td>16 unités</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- PRESTATIONS & FINITIONS INCLUSES -->
  <section class="section section--primary">
    <div class="container">
      <div class="section-title reveal">
        <span class="section-title__tagline">Prestations</span>
        <h2 class="section-title__title">Ce qui est déjà fait pour vous</h2>
      </div>
      <ul class="invest-cards reveal">
        <li>
          <div class="invest-cards__media">
            <img
              src={withBase('/images/stairs.webp')}
              alt="Finitions marbre et verrières"
              width="800"
              height="600"
              loading="lazy"
              decoding="async"
            />
          </div>
          <span class="invest-cards__num">01</span>
          <h3>Finitions soignées</h3>
          <p>Marbre et carrelage dans les parties communes, façade avec verrières.</p>
        </li>
        <li>
          <div class="invest-cards__media">
            <img
              src={withBase('/images/bathroom.webp')}
              alt="Logement prêt à l'usage"
              width="800"
              height="600"
              loading="lazy"
              decoding="async"
            />
          </div>
          <span class="invest-cards__num">02</span>
          <h3>Logement prêt à l'usage</h3>
          <p>Menuiserie et sanitaires posés, prêt à vivre dès la remise des clés.</p>
        </li>
        <li>
          <div class="invest-cards__media">
            <img
              src={withBase('/images/hall.webp')}
              alt="Parties communes terminées"
              width="800"
              height="600"
              loading="lazy"
              decoding="async"
            />
          </div>
          <span class="invest-cards__num">03</span>
          <h3>Parties communes terminées</h3>
          <p>Hall, ascenseur et accès sécurisé déjà en place.</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="section feature-list-section">
    <div class="container">
      <div class="section-title reveal">
        <span class="section-title__tagline">Avantages</span>
        <h2 class="section-title__title">
          Le bien existe déjà, pas besoin d'attendre
        </h2>
      </div>
      <ul class="list-check reveal">
        <li>Chantier livré, aucun risque de retard</li>
        <li>Visite possible cette semaine</li>
        <li>
          Financement facilité, aide de l'État possible pour les biens éligibles
        </li>
        <li>Quartier vivant, commerces en pied d'immeuble</li>
      </ul>
    </div>
  </section>

  <!-- MODALITÉS DE PAIEMENT -->
  <section class="section section--primary" id="paiement">
    <div class="container">
      <div class="section-title reveal">
        <span class="section-title__tagline">Paiement</span>
        <h2 class="section-title__title">
          Un paiement simplifié, parce que le bien est déjà livré
        </h2>
      </div>
      <div class="info-panel reveal">
        <p class="info-panel__lead">
          Contrairement à un achat sur plan, il n'y a pas d'échéancier lié à
          l'avancement des travaux. En pratique :
        </p>
        <ul class="icon-list">
          <li>
            <span class="icon" set:html={iconMoney} />
            <div>
              <strong>Acompte à la réservation</strong>
              <p>Un montant fixe pour bloquer le lot choisi.</p>
            </div>
          </li>
          <li>
            <span class="icon" set:html={iconCheck} />
            <div>
              <strong>Solde à la signature</strong>
              <p>Le reste est réglé chez le notaire, remise des clés immédiate.</p>
            </div>
          </li>
        </ul>
      </div>
      <p class="icon-list__fine">
        L'échéancier exact et le montant des charges de copropriété vous sont
        communiqués directement selon le bien qui vous intéresse.
      </p>
    </div>
  </section>

  <ContactForm
    title="Demander une visite"
    text="Indiquez votre typologie préférée, on vous rappelle rapidement."
    pageSource="appartements"
    compact
  />

  <MapSection />
</BaseLayout>